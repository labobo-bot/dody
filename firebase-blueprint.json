{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user's public profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "isVip": { "type": "boolean" },
        "membership": { "type": "string", "enum": ["premium", "influencer", "famous", "none"] },
        "role": { "type": "string" },
        "isBanned": { "type": "boolean" },
        "isMuted": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Sensitive user data.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Message": {
      "title": "Message",
      "description": "A message sent in a chat room.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "timestamp": { "type": "object" },
        "membership": { "type": "string" },
        "isVip": { "type": "boolean" },
        "isManager": { "type": "boolean" },
        "username": { "type": "string" }
      },
      "required": ["text", "uid", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profiles."
    },
    "/users/{userId}/private/info": {
      "schema": "UserPrivate",
      "description": "Sensitive user data."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Archived messages for chat rooms (RTDB is primary)."
    },
    "/system/health": {
      "schema": { "type": "object", "properties": { "status": { "type": "string" } } },
      "description": "System health check."
    },
    "/admins/{userId}": {
      "schema": { "type": "object", "properties": { "email": { "type": "string" } } },
      "description": "Admin list for elevated permissions."
    }
  }
}
